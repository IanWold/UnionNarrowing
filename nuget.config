<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Roslyn builds that match the compiler in the .NET 11 previews. nuget.org stops at 5.9.0, which predates ITypeSymbol.UnionCaseTypes.
      Drop this feed once a 5.12 (or later) Roslyn ships to nuget.org.
    -->
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-tools">
      <package pattern="Microsoft.CodeAnalysis.Analyzers" />
      <package pattern="Microsoft.CodeAnalysis.Common" />
      <package pattern="Microsoft.CodeAnalysis.CSharp" />
      <package pattern="Microsoft.CodeAnalysis.CSharp.Workspaces" />
      <package pattern="Microsoft.CodeAnalysis.Workspaces.Common" />
      <!-- Tests only: the IDE's own analyzers, to check what's suppressed in the editor. -->
      <package pattern="Microsoft.CodeAnalysis.Features" />
      <package pattern="Microsoft.CodeAnalysis.CSharp.Features" />
      <package pattern="Microsoft.CodeAnalysis.Scripting.Common" />
    </packageSource>
  </packageSourceMapping>
</configuration>
