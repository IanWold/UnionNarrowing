<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Roslyn: must not be newer than the compiler that loads the suppressor, or the compiler can't load it.
      This is the exact build in the .NET 11 RC2 SDK (11.0.100-rc.2.26504.105).
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0-1.26465.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0-1.26504.105" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0-1.26504.105" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.12.0-1.26504.105" />

    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

</Project>
