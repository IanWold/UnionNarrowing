<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Roslyn: must not be newer than the compiler that loads the suppressor, or the compiler can't load it.
      This is the exact build in the .NET 11 SDK (11.0.100, which reports itself as 11.0.100-rtm.26529.118).
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0-1.26529.118" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0-1.26529.118" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0-1.26529.118" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.12.0-1.26529.118" />

    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

</Project>
