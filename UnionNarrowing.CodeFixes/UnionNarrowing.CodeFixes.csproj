<Project Sdk="Microsoft.NET.Sdk">

  <!-- Code fixes live apart from the analyzers because they need Roslyn's Workspaces layer, which the command-line
       compiler doesn't load (RS1038). -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>UnionNarrowing.CodeFixes</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnionNarrowing.Suppressors\UnionNarrowing.Suppressors.csproj" />
  </ItemGroup>

</Project>
